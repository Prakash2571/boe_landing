# ─────────────────────────────────────────────────────────────────────────────
# Landing site environment. Copy to .env and fill in.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# BEO_API_BASE and NEWUSER_SHARED_SECRET are read ONLY on the server (route
# handlers under src/app/api/newuser/). Neither is prefixed NEXT_PUBLIC_, so
# neither is ever included in a browser bundle. Keep it that way — the signup
# secret is the app backend's only proof that a signup came from this site.
#
# Both are also read at REQUEST time, not build time, so the Docker image carries
# neither and they must be present when the container runs.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of the BeOnEdge app API, INCLUDING the /api prefix.
# The app host's nginx strips /api before proxying, so the public path is
# /api/newuser while the backend's own route is /newuser.
#   development : https://dev-app.beonedge.in/api
#   production  : https://app.beonedge.in/api
# This site runs on separate infrastructure (AWS), so it always reaches the app
# stack over the public internet — there is no private host to point at.
BEO_API_BASE=https://dev-app.beonedge.in/api

# Shared secret sent as the `x-signup-key` header on POST /newuser. It MUST be
# byte-identical to NEWUSER_SHARED_SECRET in the app stack's .env, or every
# signup is refused with 401. Generate with:  openssl rand -hex 32
NEWUSER_SHARED_SECRET=change-me-to-a-long-random-string

# ─────────────────────────────────────────────────────────────────────────────
# Deployment (docker-compose.yml). Both optional.
# ─────────────────────────────────────────────────────────────────────────────

# Which nginx vhost to mount. The default serves plain HTTP, which is what you
# want for local work and when an ALB or CloudFront terminates TLS in front.
# Set this to ./nginx/vhost-tls.conf only AFTER a certificate exists, otherwise
# nginx will not start — see the deployment section of README.md.
# NGINX_VHOST=./nginx/vhost-tls.conf
